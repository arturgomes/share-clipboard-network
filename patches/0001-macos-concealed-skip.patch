From 85ea34c54ea7c195cc46a4daa9e166767832e842 Mon Sep 17 00:00:00 2001
From: Artur Oliveira <artur.oliveira@sportsillustratedtickets.com>
Date: Mon, 27 Jul 2026 22:15:35 -0300
Subject: [PATCH] fix(macos): never sync concealed/transient clipboard items
 (AC5)

Password managers (1Password, Bitwarden, KeePassXC, ...) mark secret
clipboard content with org.nspasteboard.{Concealed,Transient,AutoGenerated}Type
per the nspasteboard.org convention. Check the general pasteboard's types
before dispatching any text/image/files update; if a concealed marker is
present, skip the send but still consume the pasteboard read so the
0.3s poller's diff/changeCount tracking advances normally (no re-fire loop).
Log only a generic debug line, never clipboard content.

The `pasteboard` package (pinned in requirements_mac.txt) has no API to
list pasteboard types (verified against its bundled __init__.pyi), so
type inspection falls back to pyobjc/AppKit's NSPasteboard.generalPasteboard()
.types() -- already a transitive runtime dependency on macOS via
gui/tray.py's `from AppKit import ...`. The type-inspection call is wrapped
in try/except so any failure degrades to current upstream behavior (send)
with a warning log, never a crash.

New clipboard/sensitive.py holds should_skip_pasteboard_types(), a pure
function with no AppKit import, so it's unit-testable without a macOS
runtime.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
---
 .../src/clipboard/clipboard_monitor_mac.py    | 45 +++++++++++++++++--
 .../src/clipboard/sensitive.py                | 45 +++++++++++++++++++
 2 files changed, 87 insertions(+), 3 deletions(-)
 create mode 100644 vendor/ClipCascade_Desktop/src/clipboard/sensitive.py

diff --git a/vendor/ClipCascade_Desktop/src/clipboard/clipboard_monitor_mac.py b/vendor/ClipCascade_Desktop/src/clipboard/clipboard_monitor_mac.py
index fd01398..0dadd52 100644
--- a/vendor/ClipCascade_Desktop/src/clipboard/clipboard_monitor_mac.py
+++ b/vendor/ClipCascade_Desktop/src/clipboard/clipboard_monitor_mac.py
@@ -4,6 +4,8 @@ import threading
 import time
 import pasteboard
 
+from clipboard.sensitive import should_skip_pasteboard_types
+
 _clipboard_thread = None
 _callback_update = None
 _run = False
@@ -21,6 +23,27 @@ def write_to_pasteboard(data, pb_type):
         _pb_writer.set_contents(data, pb_type)
 
 
+def _current_pasteboard_types():
+    """Best-effort read of the general pasteboard's advertised UTI types.
+
+    The `pasteboard` package (see requirements_mac.txt) does not expose a way
+    to list types, so fall back to pyobjc/AppKit (already a transitive
+    runtime dependency on macOS via pystray/gui.tray -- see gui/tray.py).
+    Returns None on any failure so callers degrade to current upstream
+    behavior (send) instead of crashing the monitor.
+    """
+    try:
+        from AppKit import NSPasteboard
+
+        raw_types = NSPasteboard.generalPasteboard().types()
+        if raw_types is None:
+            return []
+        return [str(t) for t in raw_types]
+    except Exception as e:
+        logging.warning(f"Unable to inspect pasteboard types, assuming non-concealed: {e}")
+        return None
+
+
 def _runner(enable_image_monitoring=False, enable_file_monitoring=False):
     global _first_run, _block_image_once
     try:
@@ -35,6 +58,12 @@ def _runner(enable_image_monitoring=False, enable_file_monitoring=False):
         while _run:
             # don't change the execution order (files,text,image or files,image,text)
 
+            # Concealed/transient/auto-generated content (password managers, e.g.
+            # 1Password/Bitwarden/KeePassXC per the nspasteboard.org convention)
+            # must never be synced. Checked once per poll -- it's a
+            # pasteboard-wide marker, not per-content-type.
+            _skip_concealed = should_skip_pasteboard_types(_current_pasteboard_types())
+
             if enable_file_monitoring:
                 # Files
                 with _pasteboard_lock:
@@ -45,8 +74,11 @@ def _runner(enable_image_monitoring=False, enable_file_monitoring=False):
                     and len(clipboard_files) > 0
                 ):
                     if _callback_update and not _first_run:
-                        files_processed = True
-                        _callback_update("files", clipboard_files)
+                        if _skip_concealed:
+                            logging.debug("skipped concealed/transient clipboard item")
+                        else:
+                            files_processed = True
+                            _callback_update("files", clipboard_files)
 
             # Text
             with _pasteboard_lock:
@@ -60,7 +92,10 @@ def _runner(enable_image_monitoring=False, enable_file_monitoring=False):
                 and len(clipboard_text) > 0
             ):
                 if _callback_update and not _first_run and not files_processed:
-                    _callback_update("text", clipboard_text)
+                    if _skip_concealed:
+                        logging.debug("skipped concealed/transient clipboard item")
+                    else:
+                        _callback_update("text", clipboard_text)
 
             if enable_image_monitoring:
                 # Image (PNG)
@@ -76,6 +111,8 @@ def _runner(enable_image_monitoring=False, enable_file_monitoring=False):
                         image_processed = True
                         if _block_image_once:
                             _block_image_once = False
+                        elif _skip_concealed:
+                            logging.debug("skipped concealed/transient clipboard item")
                         else:
                             if not files_processed:
                                 _callback_update("image", clipboard_image_png)
@@ -93,6 +130,8 @@ def _runner(enable_image_monitoring=False, enable_file_monitoring=False):
                         image_processed = True
                         if _block_image_once:
                             _block_image_once = False
+                        elif _skip_concealed:
+                            logging.debug("skipped concealed/transient clipboard item")
                         else:
                             if not files_processed:
                                 _callback_update("image", clipboard_image_tiff)
diff --git a/vendor/ClipCascade_Desktop/src/clipboard/sensitive.py b/vendor/ClipCascade_Desktop/src/clipboard/sensitive.py
new file mode 100644
index 0000000..a0cbf35
--- /dev/null
+++ b/vendor/ClipCascade_Desktop/src/clipboard/sensitive.py
@@ -0,0 +1,45 @@
+# Pure, platform-independent helpers for detecting clipboard content that
+# password managers mark as sensitive, so ClipCascade never syncs it across
+# devices. No AppKit / GTK imports here on purpose -- these functions must be
+# importable and unit-testable without a display server or macOS runtime.
+
+# nspasteboard.org convention, honored by 1Password, Bitwarden, KeePassXC, etc.
+# When any of these UTIs is present on the macOS general pasteboard alongside
+# the copied content, the content is considered concealed/transient and must
+# not be sent.
+CONCEALED_PASTEBOARD_TYPES = frozenset(
+    {
+        "org.nspasteboard.ConcealedType",
+        "org.nspasteboard.TransientType",
+        "org.nspasteboard.AutoGeneratedType",
+    }
+)
+
+# Set by KeePassXC (and other password managers) as an extra clipboard
+# MIME/X target on X11 (xclip) and Wayland (wl-clipboard) to mark clipboard
+# content that must not be persisted or synced elsewhere.
+SENSITIVE_MIME_TARGETS = frozenset(
+    {
+        "x-kde-passwordManagerHint",
+    }
+)
+
+
+def should_skip_pasteboard_types(types):
+    """Return True if `types` (the macOS general pasteboard's advertised
+    UTI types for the current clipboard contents) contains any nspasteboard.org
+    concealed/transient/auto-generated marker. Empty/None input means "unknown"
+    and never skips."""
+    if not types:
+        return False
+    return not CONCEALED_PASTEBOARD_TYPES.isdisjoint(types)
+
+
+def should_skip_mime_targets(targets):
+    """Return True if `targets` (the Linux clipboard's advertised MIME/X
+    targets for the current clipboard contents) contains a password-manager
+    hint such as KeePassXC's x-kde-passwordManagerHint. Empty/None input means
+    "unknown" and never skips."""
+    if not targets:
+        return False
+    return not SENSITIVE_MIME_TARGETS.isdisjoint(targets)
